@model EduHub.Web.ViewModels.Instructor.CreateCourseViewModel
@using EduHub.Data.Enums
@{
    ViewData["Title"] = "Create Course";
}

<header class="site-header d-flex flex-column justify-content-center align-items-center" style="padding-top: 130px; padding-bottom: 50px;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-white-50">Dashboard</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Create Course</li>
            </ol>
        </nav>
        <h2 class="text-white mb-1">Create New Course</h2>
        <p class="text-white-50 mb-0">Set up your course details, pricing, and publish status.</p>
    </div>
</header>

<section class="section-padding section-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-12">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <form asp-action="CreateCourse" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control rounded-3" placeholder="e.g., Mastering Entity Framework Core" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                                <select asp-for="CategoryId" class="form-select rounded-3">
                                    <option value="">-- Select Category --</option>
                                    @foreach (var cat in Model.Categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-semibold"></label>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control rounded-3" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Level" class="form-label fw-semibold"></label>
                                <select asp-for="Level" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<CourseLevel>()"></select>
                                <span asp-validation-for="Level" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold"></label>
                                <select asp-for="Status" class="form-select rounded-3">
                                    <option value="@CourseStatus.Draft">Draft (Hidden from catalog)</option>
                                    <option value="@CourseStatus.Published">Published (Visible to students)</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn custom-btn rounded-pill px-4">
                                <i class="bi-check-lg me-1"></i> Create & Manage Curriculum
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
