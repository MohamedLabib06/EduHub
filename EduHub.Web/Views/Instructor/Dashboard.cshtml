@model EduHub.Web.ViewModels.Instructor.InstructorDashboardViewModel
@using EduHub.Data.Enums
@{
    ViewData["Title"] = "Instructor Dashboard";
}

<header class="site-header d-flex flex-column justify-content-center align-items-center" style="padding-top: 130px; padding-bottom: 50px;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 col-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Instructor Dashboard</li>
                    </ol>
                </nav>
                <h2 class="text-white mb-1">Welcome, @Model.InstructorName</h2>
                <p class="text-white-50 mb-0">@(string.IsNullOrWhiteSpace(Model.Headline) ? "Manage your courses, curriculum, quizzes, and earnings." : Model.Headline)</p>
            </div>
            <div class="col-lg-4 col-12 text-lg-end mt-3 mt-lg-0">
                <a asp-action="CreateCourse" class="btn btn-light rounded-pill px-4 fw-bold">
                    <i class="bi-plus-circle me-1"></i> Create New Course
                </a>
            </div>
        </div>
    </div>
</header>

<section class="section-padding section-bg">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                <i class="bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                <i class="bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Stats Cards -->
        <div class="row g-4 mb-5">
            <div class="col-md-3 col-sm-6 col-12">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 me-3">
                            <i class="bi-currency-dollar fs-3"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Total Earnings</small>
                            <h4 class="mb-0 fw-bold">$@Model.TotalEarnings.ToString("0.00")</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6 col-12">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3">
                            <i class="bi-people fs-3"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Total Students</small>
                            <h4 class="mb-0 fw-bold">@Model.TotalStudents</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6 col-12">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="bg-info bg-opacity-10 text-info rounded-circle p-3 me-3">
                            <i class="bi-journal-bookmark fs-3"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Total Courses</small>
                            <h4 class="mb-0 fw-bold">@Model.TotalCourses</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6 col-12">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 me-3">
                            <i class="bi-broadcast fs-3"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Published</small>
                            <h4 class="mb-0 fw-bold">@Model.PublishedCourses</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Instructor Courses Table -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">My Courses</h4>
                <a asp-action="CreateCourse" class="btn custom-btn btn-sm rounded-pill px-3">
                    <i class="bi-plus-lg me-1"></i> New Course
                </a>
            </div>

            @if (!Model.Courses.Any())
            {
                <div class="text-center py-5">
                    <i class="bi-easel display-3 text-muted mb-3"></i>
                    <h5>You haven't created any courses yet</h5>
                    <p class="text-muted mb-4">Create your first course and start adding sections, lessons, and quizzes.</p>
                    <a asp-action="CreateCourse" class="btn custom-btn rounded-pill px-4">Create Course</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Course</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th>Content</th>
                                <th>Students</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model.Courses)
                            {
                                var lessonCount = course.Sections.Sum(s => s.Lessons.Count);
                                var quizCount = course.Sections.Sum(s => s.Quizzes.Count);
                                <tr>
                                    <td>
                                        <div class="fw-bold">@course.Title</div>
                                        <small class="text-muted">@course.Level • ⭐ @course.AverageRating.ToString("0.0")</small>
                                    </td>
                                    <td>@course.Category?.Name</td>
                                    <td>$@course.Price.ToString("0.00")</td>
                                    <td>
                                        <span class="badge @(course.Status == CourseStatus.Published ? "bg-success" : "bg-secondary") rounded-pill px-3">
                                            @course.Status
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">@course.Sections.Count sec • @lessonCount lessons • @quizCount quizzes</small>
                                    </td>
                                    <td>@course.Enrollments.Count</td>
                                    <td class="text-end">
                                        <a asp-action="ManageCurriculum" asp-route-id="@course.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            <i class="bi-gear me-1"></i> Manage Curriculum
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>
