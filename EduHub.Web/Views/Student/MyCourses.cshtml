@model IEnumerable<EduHub.Web.ViewModels.Student.MyCourseItemViewModel>
@{
    ViewData["Title"] = "My Courses";
}

<!-- Page Header -->
<header class="site-header d-flex flex-column justify-content-center align-items-center py-5" style="background: linear-gradient(135deg, #13547a 0%, #80d0c7 100%);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 col-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">My Courses</li>
                    </ol>
                </nav>
                <h2 class="text-white fw-bold mb-1">My Learning Dashboard</h2>
                <p class="text-white-50 mb-0">Track your enrolled courses, lesson progress, and certificates.</p>
            </div>
            <div class="col-lg-4 col-12 text-lg-end mt-3 mt-lg-0">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                    <i class="bi-search me-1"></i> Browse More Courses
                </a>
            </div>
        </div>
    </div>
</header>

<section class="section-padding py-5">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                <i class="bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                <i class="bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="bi-mortarboard display-1 text-muted"></i>
                </div>
                <h4 class="fw-bold text-dark">You haven't enrolled in any courses yet</h4>
                <p class="text-muted mb-4">Start your learning journey today by exploring our wide range of professional topics.</p>
                <a asp-controller="Home" asp-action="Index" class="btn custom-btn px-4 py-2">
                    Explore All Topics
                </a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6 col-12 mb-4">
                        <div class="custom-block bg-white shadow-sm rounded-4 p-4 h-100 d-flex flex-column border">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-light text-primary border rounded-pill px-3 py-2">
                                    <i class="bi-tag me-1"></i> @item.CategoryName
                                </span>
                                <span class="badge @(item.IsCompleted ? "bg-success" : "bg-info") text-white rounded-pill px-3 py-2">
                                    @(item.IsCompleted ? "Completed" : "In Progress")
                                </span>
                            </div>

                            <h5 class="fw-bold mb-2">
                                <a asp-controller="Student" asp-action="Watch" asp-route-courseId="@item.CourseId" class="text-dark text-decoration-none">
                                    @item.CourseTitle
                                </a>
                            </h5>

                            <p class="text-muted small mb-3">
                                <i class="bi-person me-1"></i> Instructor: <strong>@item.InstructorName</strong> • <i class="bi-bar-chart me-1"></i> @item.Level
                            </p>

                            <!-- Progress Bar -->
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Progress</span>
                                    <strong>@item.ProgressPercentage%</strong>
                                </div>
                                <div class="progress mb-3" style="height: 8px;">
                                    <div class="progress-bar @(item.IsCompleted ? "bg-success" : "bg-primary")" role="progressbar"
                                         style="width: @item.ProgressPercentage%;"
                                         aria-valuenow="@item.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center small text-muted mb-3">
                                    <span><i class="bi-check2-circle me-1"></i> @item.CompletedLessonsCount / @item.TotalLessonsCount Lessons</span>
                                    <span>Enrolled: @item.EnrolledAt.ToString("MMM dd, yyyy")</span>
                                </div>

                                @if (!string.IsNullOrEmpty(item.CertificateCode))
                                {
                                    <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 d-flex align-items-center">
                                        <i class="bi-award-fill fs-5 text-warning me-2"></i>
                                        <div class="text-truncate">
                                            <strong>Certificate:</strong> <code>@item.CertificateCode</code>
                                        </div>
                                    </div>
                                }

                                <a asp-controller="Student" asp-action="Watch" asp-route-courseId="@item.CourseId"
                                   class="btn @(item.IsCompleted ? "btn-outline-success" : "btn-primary") w-100 rounded-pill py-2">
                                    <i class="bi-play-circle me-1"></i> @(item.IsCompleted ? "Review Course" : "Continue Learning")
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
