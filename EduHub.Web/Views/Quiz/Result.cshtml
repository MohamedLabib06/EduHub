@model EduHub.Data.Entities.QuizAttempt
@{
    ViewData["Title"] = $"Quiz Result - {Model.Quiz.Title}";
    var selectedChoices = ViewBag.SelectedChoices as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<header class="site-header d-flex flex-column justify-content-center align-items-center" style="padding-top: 130px; padding-bottom: 50px;">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Student" asp-action="MyCourses" class="text-white-50">My Courses</a></li>
                <li class="breadcrumb-item"><a asp-controller="Student" asp-action="Watch" asp-route-courseId="@Model.Quiz.Section.CourseId" class="text-white-50">@Model.Quiz.Section.Course.Title</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Result</li>
            </ol>
        </nav>
        <h2 class="text-white mb-1">@Model.Quiz.Title — Results</h2>
        <p class="text-white-50 mb-0">Attempt recorded on @Model.AttemptDate.ToString("MMM dd, yyyy HH:mm") UTC</p>
    </div>
</header>

<section class="section-padding section-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-12">
                <!-- Score Summary Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5 text-center bg-white">
                    <div class="mb-3">
                        @if (Model.IsPassed)
                        {
                            <i class="bi-trophy-fill display-2 text-success"></i>
                        }
                        else
                        {
                            <i class="bi-x-circle-fill display-2 text-danger"></i>
                        }
                    </div>

                    <h2 class="fw-bold mb-2 @(Model.IsPassed ? "text-success" : "text-danger")">
                        @(Model.IsPassed ? "Passed!" : "Not Passed Yet")
                    </h2>

                    <p class="text-muted mb-4">
                        Your Score: <strong class="text-dark fs-4">@Model.Score.ToString("0.##")%</strong>
                        (Required: @Model.Quiz.PassingScore.ToString("0.##")%)
                    </p>

                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a asp-action="TakeQuiz" asp-route-id="@Model.QuizId" class="btn btn-outline-primary rounded-pill px-4">
                            <i class="bi-arrow-repeat me-1"></i> Retake Quiz
                        </a>
                        <a asp-controller="Student" asp-action="Watch" asp-route-courseId="@Model.Quiz.Section.CourseId" class="btn custom-btn rounded-pill px-4">
                            <i class="bi-play-circle me-1"></i> Back to Course Player
                        </a>
                    </div>
                </div>

                <!-- Answer Review (shown ONLY after submission) -->
                <h4 class="mb-3">Answer Review</h4>
                @foreach (var question in Model.Quiz.Questions)
                {
                    selectedChoices.TryGetValue(question.Id, out int pickedChoiceId);
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-3 bg-white">
                        <h6 class="fw-bold mb-3">@question.QuestionText <small class="text-muted fw-normal">(@question.Points pts)</small></h6>
                        <ul class="list-group list-group-flush">
                            @foreach (var choice in question.Choices)
                            {
                                bool isSelected = choice.Id == pickedChoiceId;
                                string rowClass = choice.IsCorrect
                                    ? "list-group-item-success"
                                    : (isSelected ? "list-group-item-danger" : "");
                                <li class="list-group-item @rowClass d-flex justify-content-between align-items-center rounded-2 mb-1">
                                    <span>@choice.ChoiceText</span>
                                    <span>
                                        @if (choice.IsCorrect)
                                        {
                                            <span class="badge bg-success">Correct Answer</span>
                                        }
                                        @if (isSelected && !choice.IsCorrect)
                                        {
                                            <span class="badge bg-danger">Your Answer</span>
                                        }
                                        else if (isSelected && choice.IsCorrect)
                                        {
                                            <span class="badge bg-dark ms-1">Your Answer</span>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
